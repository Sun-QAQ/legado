<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_source_card"
    android:orientation="vertical">

    <!-- 书源概要：头像 + 名称/分组 + 更多操作 + 展开箭头 -->
    <LinearLayout
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingLeft="13dp"
        android:paddingTop="11dp"
        android:paddingRight="10dp"
        android:paddingBottom="11dp"
        tools:ignore="RtlHardcoded">

        <TextView
            android:id="@+id/tv_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_source_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="起" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/primaryText"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="起点中文网" />

            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/secondaryText"
                android:textSize="11sp"
                tools:text="正版 · 支持登录" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_menu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="@color/secondaryText" />

        <ImageView
            android:id="@+id/iv_status"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/secondaryText" />

    </LinearLayout>

    <!-- 发现分类：展开后才解析并渲染 -->
    <LinearLayout
        android:id="@+id/ll_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="15dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/bg_divider_line" />

        <LinearLayout
            android:id="@+id/ll_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="3dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:ignore="RtlHardcoded">

            <io.legado.app.ui.widget.anima.RotateLoading
                android:id="@+id/rotate_loading"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:loading_width="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/explore_kinds_loading"
                android:textColor="@color/secondaryText"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 发现分类：默认三列等宽，书源可通过 kind.style 的 flex 参数调整 -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:flexDirection="row"
            app:flexWrap="wrap" />
    </LinearLayout>

</LinearLayout>
