<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_card_view"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tool_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="?attr/actionBarStyle"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            app:title="@string/ai_search_source"
            app:titleTextAppearance="@style/ToolbarTitle" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_source_name">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_search_type">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_source_base_url">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_base_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_source_api_key"
                    app:helperText="@string/ai_search_api_key_helper">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textPassword|textMultiLine"
                        android:maxLines="5"
                        android:minLines="2"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_search_default_count">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_default_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:hint="@string/ai_search_language">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_language"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>
                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:hint="@string/ai_search_country">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_country"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>
                </LinearLayout>

                <io.legado.app.lib.theme.view.ThemeSwitch
                    android:id="@+id/swt_safe_search"
                    android:name="@string/ai_search_safe_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:padding="12dp"
                    android:text="@string/ai_search_safe_search" />

                <LinearLayout
                    android:id="@+id/custom_mapping_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_method">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_method"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_query_parameter">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_query_parameter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_result_path">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_result_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_title_path">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_title_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_url_path">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_url_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_snippet_path">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_snippet_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:hint="@string/ai_search_published_at_path">
                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/tv_published_at_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp" />
                    </io.legado.app.ui.widget.text.TextInputLayout>
                </LinearLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_search_custom_body">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_custom_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="4"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:hint="@string/ai_source_headers">
                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/tv_headers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="3"
                        android:padding="14dp" />
                </io.legado.app.ui.widget.text.TextInputLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
