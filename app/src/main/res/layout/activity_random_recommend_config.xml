<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/random_recommend_config" />

    <io.legado.app.ui.widget.SearchView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_searchview"
        android:focusable="false"
        android:imeOptions="actionSearch"
        android:theme="?attr/actionBarStyle"
        app:defaultQueryHint="@string/search_book_source"
        app:iconifiedByDefault="false"
        app:queryBackground="@null"
        app:searchHintIcon="@drawable/ic_search_hint"
        app:searchIcon="@null"
        app:submitBackground="@null" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_group"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:theme="?attr/actionBarStyle"
        app:tabMode="scrollable"
        app:tabBackground="@android:color/transparent"
        app:tabMaxWidth="100dp"
        app:tabMinWidth="10dp"
        app:tabRippleColor="@android:color/transparent" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="@string/random_recommend_config_hint"
        android:textColor="@color/secondaryText"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
