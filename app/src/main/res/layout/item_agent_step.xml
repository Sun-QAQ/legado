<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ProgressBar
        android:id="@+id/progress_step"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:indeterminateTint="@color/secondaryText" />

    <ImageView
        android:id="@+id/iv_step_state"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryText"
            android:textSize="13sp"
            tools:text="调用工具 search_books" />

        <TextView
            android:id="@+id/tv_step_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondaryText"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="query=斗破苍穹 · 1.2s"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_step_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondaryText"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="返回 10 条结果"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
