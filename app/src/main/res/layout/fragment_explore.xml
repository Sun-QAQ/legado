<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 无标题栏，仅占位状态栏高度 -->
    <FrameLayout
        android:id="@+id/vw_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 常驻搜索框，替代隐藏在工具栏里的筛选 -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_explore_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        app:layout_constraintTop_toBottomOf="@id/vw_status_bar">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/secondaryText" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/screen_find"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/primaryText"
            android:textColorHint="@color/secondaryText"
            android:textSize="14sp"
            tools:ignore="RtlHardcoded" />

        <ImageView
            android:id="@+id/iv_clear_search"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_baseline_close"
            android:visibility="gone"
            app:tint="@color/secondaryText"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 书源分组筛选：与书架页分组保持一致的 TabLayout 样式 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_group"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:theme="?attr/actionBarStyle"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:tabBackground="@android:color/transparent"
        app:tabMaxWidth="100dp"
        app:tabMinWidth="10dp"
        app:tabRippleColor="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/ll_section_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="23dp"
        android:paddingTop="3dp"
        android:paddingRight="23dp"
        android:paddingBottom="11dp"
        app:layout_constraintTop_toBottomOf="@id/tab_group"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/tv_source_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/secondaryText"
            android:textSize="12sp"
            tools:text="5 个发现源" />

        <TextView
            android:id="@+id/tv_collapse_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/explore_collapse_all"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <io.legado.app.ui.widget.recycler.RecyclerViewAtPager2
        android:id="@+id/rv_find"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_section_meta"
        tools:listitem="@layout/item_find_book" />

    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="64dp"
        android:paddingRight="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_section_meta"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_explore_empty_visual"
            android:importantForAccessibility="no"
            android:padding="22dp"
            android:src="@drawable/ic_search"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/explore_empty_title"
            android:textColor="@color/primaryText"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/explore_empty_desc"
            android:textColor="@color/secondaryText"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
