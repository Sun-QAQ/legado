<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/vw_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:text="@string/url_option"
            android:textColor="@color/primaryText"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/url_option_hint"
                    android:textColor="@color/secondaryText"
                    android:textSize="14sp" />

                <io.legado.app.lib.theme.view.ThemeCheckBox
                    android:id="@+id/cb_use_web_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/url_option_use_web_view"
                    android:textSize="14sp" />

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_method"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_method">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_method"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textNoSuggestions"
                        android:gravity="center_vertical"
                        android:singleLine="true" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_charset"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_charset">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_charset"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textNoSuggestions"
                        android:gravity="center_vertical"
                        android:singleLine="true" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_headers"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_headers">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_headers"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:gravity="center_vertical|start"
                        android:minLines="1"
                        android:scrollbars="vertical"
                        android:maxLines="6" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_body"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_body">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_body"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:gravity="center_vertical|start"
                        android:minLines="1"
                        android:scrollbars="vertical"
                        android:maxLines="6" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_type"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_type">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_type"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textNoSuggestions"
                        android:gravity="center_vertical"
                        android:singleLine="true" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_retry"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_retry">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_retry"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="number"
                        android:gravity="center_vertical"
                        android:singleLine="true" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_web_js"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_web_js">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_web_js"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:gravity="center_vertical|start"
                        android:minLines="1"
                        android:scrollbars="vertical"
                        android:maxLines="6" />

                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:id="@+id/layout_js"
                    style="@style/Widget.Legado.UrlOptionInput"
                    android:hint="@string/url_option_js">

                    <io.legado.app.ui.widget.text.AutoCompleteTextView
                        android:id="@+id/edit_js"
                        style="@style/Widget.Legado.UrlOptionEditText"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:gravity="center_vertical|start"
                        android:minLines="1"
                        android:scrollbars="vertical"
                        android:maxLines="6" />

                </io.legado.app.ui.widget.text.TextInputLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/ok"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
