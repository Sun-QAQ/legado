<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Legado.HttpTtsInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Legado.HttpTtsEditText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:inputType">textNoSuggestions</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Legado.HttpTtsCodeEditText" parent="Widget.Legado.HttpTtsEditText">
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textNoSuggestions</item>
        <item name="android:singleLine">false</item>
        <item name="android:minLines">3</item>
        <item name="android:maxLines">6</item>
        <item name="android:scrollbars">vertical</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
