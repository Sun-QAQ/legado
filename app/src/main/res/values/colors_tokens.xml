<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      P0 设计 Token · 亮色（来自 ui-redesign-preview.html 原型色板）
      命名遵循 Material Theme Builder 的 md_theme_light_* 约定，避免与 colors.xml 现有名字冲突。
      本文件为纯新增，不影响现有渲染；P1 阶段再让主题消费这些 token。
    -->

    <!-- Primary：紫罗兰渐变主色（token 已移除，改为 colors.xml 直接色值 + 运行时 ThemeStore.primaryColor） -->
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <color name="md_theme_light_primaryContainer">#E7E1FF</color>
    <color name="md_theme_light_onPrimaryContainer">#241A55</color>

    <!-- Secondary：暖中性灰（次要信息/次按钮） -->
    <color name="md_theme_light_secondary">#6E6760</color>
    <color name="md_theme_light_onSecondary">#FFFFFF</color>
    <color name="md_theme_light_secondaryContainer">#F0EDE9</color>
    <color name="md_theme_light_onSecondaryContainer">#26211D</color>

    <!-- Tertiary：冷绿色点缀（榜单/成功等辅助色） -->
    <color name="md_theme_light_tertiary">#557A71</color>
    <color name="md_theme_light_onTertiary">#FFFFFF</color>
    <color name="md_theme_light_tertiaryContainer">#D6EBE1</color>
    <color name="md_theme_light_onTertiaryContainer">#13251F</color>

    <!-- Error -->
    <color name="md_theme_light_error">#BA1A1A</color>
    <color name="md_theme_light_onError">#FFFFFF</color>
    <color name="md_theme_light_errorContainer">#FFDAD6</color>
    <color name="md_theme_light_onErrorContainer">#410002</color>

    <!-- Surface 体系：背景色即原型 bg（#F4F2EE），卡片用 Container 层级 -->
    <color name="md_theme_light_background">#F4F2EE</color>
    <color name="md_theme_light_onBackground">#211D1A</color>
    <color name="md_theme_light_surface">#F4F2EE</color>
    <color name="md_theme_light_onSurface">#211D1A</color>
    <color name="md_theme_light_surfaceVariant">#F0EDE9</color>
    <color name="md_theme_light_onSurfaceVariant">#6E6760</color>

    <!-- 卡片色调阶（对应原型 surface/surface-2/surface-3） -->
    <color name="md_theme_light_surfaceContainerLowest">#FFFFFF</color>
    <color name="md_theme_light_surfaceContainerLow">#FAF8F4</color>
    <color name="md_theme_light_surfaceContainer">#F4F2EE</color>
    <color name="md_theme_light_surfaceContainerHigh">#EFECE8</color>
    <color name="md_theme_light_surfaceContainerHighest">#E9E6E2</color>

    <!-- 描边/分隔线 -->
    <color name="md_theme_light_outline">#837C74</color>
    <color name="md_theme_light_outlineVariant">#E6E3DF</color>

    <color name="md_theme_light_scrim">#000000</color>

    <!-- 昼夜自适应别名（供布局/样式引用，P1 换 M3 主题后可迁移为 ?attr/colorPrimaryContainer） -->
    <color name="color_primary_container">@color/md_theme_light_primaryContainer</color>
    <color name="color_surface">@color/md_theme_light_surface</color>
    <color name="color_card">@color/md_theme_light_surfaceContainerLowest</color>
    <color name="color_surface_variant">@color/md_theme_light_surfaceVariant</color>
</resources>